@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://hl7.no/fhir/ig/Patient/PatientExample> a fhir:Patient ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "PatientExample"] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Patient PatientExample</b></p><a name=\"PatientExample\"> </a><a name=\"hcPatientExample\"> </a><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">Peter James Chalmers (official) (no stated gender), DoB Unknown</p><hr/></div>"
  ] ;
  fhir:Patient.name [
     fhir:index 0 ;
     fhir:HumanName.use [ fhir:value "official" ] ;
     fhir:HumanName.family [ fhir:value "Chalmers" ] ;
     fhir:HumanName.given [
       fhir:value "Peter James" ;
       fhir:index 0
     ]
  ] .

# - ontology header ------------------------------------------------------------

<http://hl7.no/fhir/ig/Patient/PatientExample.ttl> a owl:Ontology ;
  owl:imports fhir:fhir.ttl .

# -------------------------------------------------------------------------------------

